{
  "name": "repoflare",
  "displayName": "RepoFlare",
  "description": "Repository intelligence: structure, graph, and change impact.",
  "version": "0.1.0",
  "publisher": "repoflare",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "repoflare.showOverview",
        "title": "RepoFlare: Show Repository Overview"
      },
      {
        "command": "repoflare.analyze",
        "title": "RepoFlare: Analyze Repository"
      },
      {
        "command": "repoflare.showImpact",
        "title": "RepoFlare: Show Impact for Ref Range…"
      }
    ],
    "configuration": {
      "title": "RepoFlare",
      "properties": {
        "repoflare.pythonPath": {
          "type": "string",
          "default": "python",
          "description": "Path to the Python interpreter that has repoflare_core installed."
        }
      }
    }
  },
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --sourcemap",
    "watch": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --sourcemap --watch",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "node --import tsx --test test/**/*.test.ts",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^2.22.0",
    "esbuild": "^0.20.0",
    "tsx": "^4.23.15",
    "typescript": "^5.3.0"
  }
}
