# ============================================
# REPOFLARE - ENVIRONMENT VARIABLES
# ============================================
#
# 1. Copy this file to .env (already in .gitignore / .bobignore)
#    cp .env.example .env
# 2. Fill in real values
# 3. NEVER commit .env, and never paste real keys into a Bob/Claude chat
#
# ============================================

# BobProvider — see docs/DECISIONS.md ADR-004 (Gemini primary, OpenRouter fallback)
GEMINI_API_KEY=your_gemini_api_key_here_DO_NOT_COMMIT
OPENROUTER_API_KEY=your_openrouter_api_key_here_DO_NOT_COMMIT
